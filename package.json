{
  "name": "dsh-campus-seu",
  "version": "0.3.0",
  "private": true,
  "description": "Southeast University campus theme for DeepSeek Harness Web.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "ATTRIBUTION.md",
    "docs/dingdong-generation.md",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run build && pnpm run test",
    "dev": "node scripts/dev.mjs",
    "dsh": "node scripts/dsh.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "esbuild": "0.25.12",
    "react": "18.3.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinyang20/dsh-campus-seu.git"
  },
  "homepage": "https://github.com/xinyang20/dsh-campus-seu#readme",
  "bugs": {
    "url": "https://github.com/xinyang20/dsh-campus-seu/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "campus-theme",
    "southeast-university",
    "seu"
  ]
}
